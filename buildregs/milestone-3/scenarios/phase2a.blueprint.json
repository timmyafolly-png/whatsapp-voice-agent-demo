{
 "name": "BuildRegs Phase 2a - Quote prepared, await approval",
 "metadata": {
  "version": 1
 },
 "flow": [
  {
   "id": 1,
   "module": "gateway:CustomWebHook",
   "version": 1,
   "metadata": {
    "designer": {
     "x": 0,
     "y": 0,
     "name": "1. Quote prepared on the review page"
    },
    "restore": {
     "parameters": {
      "hook": {
       "label": "BuildRegs Quote Prepared",
       "data": {
        "editable": "true"
       }
      }
     }
    }
   },
   "parameters": {
    "hook": 3960316,
    "maxResults": 1
   },
   "mapper": {}
  },
  {
   "id": 2,
   "module": "util:SetVariables",
   "version": 1,
   "metadata": {
    "designer": {
     "x": 300,
     "y": 0,
     "name": "2. Read the four slots"
    }
   },
   "mapper": {
    "scope": "roundtrip",
    "variables": [
     {
      "name": "p1",
      "value": "{{if(length(trim(ifempty(1.type1; \"\"))) > 0; parseNumber(ifempty(1.price1; 0)); 0)}}"
     },
     {
      "name": "p2",
      "value": "{{if(length(trim(ifempty(1.type2; \"\"))) > 0; parseNumber(ifempty(1.price2; 0)); 0)}}"
     },
     {
      "name": "p3",
      "value": "{{if(length(trim(ifempty(1.type3; \"\"))) > 0; parseNumber(ifempty(1.price3; 0)); 0)}}"
     },
     {
      "name": "p4",
      "value": "{{if(length(trim(ifempty(1.type4; \"\"))) > 0; parseNumber(ifempty(1.price4; 0)); 0)}}"
     },
     {
      "name": "n1",
      "value": "{{if(length(trim(ifempty(1.type1; \"\"))) > 0; 1; 0)}}"
     },
     {
      "name": "n2",
      "value": "{{if(length(trim(ifempty(1.type2; \"\"))) > 0; 1; 0)}}"
     },
     {
      "name": "n3",
      "value": "{{if(length(trim(ifempty(1.type3; \"\"))) > 0; 1; 0)}}"
     },
     {
      "name": "n4",
      "value": "{{if(length(trim(ifempty(1.type4; \"\"))) > 0; 1; 0)}}"
     },
     {
      "name": "b1",
      "value": "{{if(length(trim(ifempty(1.type1; \"\"))) > 0; parseNumber(ifempty(1.price1; 0)); 9000000000)}}"
     },
     {
      "name": "b2",
      "value": "{{if(length(trim(ifempty(1.type2; \"\"))) > 0; parseNumber(ifempty(1.price2; 0)); 9000000000)}}"
     },
     {
      "name": "b3",
      "value": "{{if(length(trim(ifempty(1.type3; \"\"))) > 0; parseNumber(ifempty(1.price3; 0)); 9000000000)}}"
     },
     {
      "name": "b4",
      "value": "{{if(length(trim(ifempty(1.type4; \"\"))) > 0; parseNumber(ifempty(1.price4; 0)); 9000000000)}}"
     }
    ]
   }
  },
  {
   "id": 3,
   "module": "util:SetVariables",
   "version": 1,
   "metadata": {
    "designer": {
     "x": 600,
     "y": 0,
     "name": "3. Subtotal and lowest price"
    }
   },
   "mapper": {
    "scope": "roundtrip",
    "variables": [
     {
      "name": "subtotal",
      "value": "{{2.p1 + 2.p2 + 2.p3 + 2.p4}}"
     },
     {
      "name": "typeCount",
      "value": "{{2.n1 + 2.n2 + 2.n3 + 2.n4}}"
     },
     {
      "name": "minPrice",
      "value": "{{if(if(2.b1 < 2.b2; 2.b1; 2.b2) < if(2.b3 < 2.b4; 2.b3; 2.b4); if(2.b1 < 2.b2; 2.b1; 2.b2); if(2.b3 < 2.b4; 2.b3; 2.b4))}}"
     },
     {
      "name": "typesCsv",
      "value": "{{if(length(if(length(trim(ifempty(1.type1; \"\"))) > 0; \", \" + 1.type1; \"\") + if(length(trim(ifempty(1.type2; \"\"))) > 0; \", \" + 1.type2; \"\") + if(length(trim(ifempty(1.type3; \"\"))) > 0; \", \" + 1.type3; \"\") + if(length(trim(ifempty(1.type4; \"\"))) > 0; \", \" + 1.type4; \"\")) > 2; substring(if(length(trim(ifempty(1.type1; \"\"))) > 0; \", \" + 1.type1; \"\") + if(length(trim(ifempty(1.type2; \"\"))) > 0; \", \" + 1.type2; \"\") + if(length(trim(ifempty(1.type3; \"\"))) > 0; \", \" + 1.type3; \"\") + if(length(trim(ifempty(1.type4; \"\"))) > 0; \", \" + 1.type4; \"\"); 2); \"\")}}"
     },
     {
      "name": "pricesCsv",
      "value": "{{if(length(if(length(trim(ifempty(1.type1; \"\"))) > 0; \", \" + 1.price1; \"\") + if(length(trim(ifempty(1.type2; \"\"))) > 0; \", \" + 1.price2; \"\") + if(length(trim(ifempty(1.type3; \"\"))) > 0; \", \" + 1.price3; \"\") + if(length(trim(ifempty(1.type4; \"\"))) > 0; \", \" + 1.price4; \"\")) > 2; substring(if(length(trim(ifempty(1.type1; \"\"))) > 0; \", \" + 1.price1; \"\") + if(length(trim(ifempty(1.type2; \"\"))) > 0; \", \" + 1.price2; \"\") + if(length(trim(ifempty(1.type3; \"\"))) > 0; \", \" + 1.price3; \"\") + if(length(trim(ifempty(1.type4; \"\"))) > 0; \", \" + 1.price4; \"\"); 2); \"\")}}"
     }
    ]
   }
  },
  {
   "id": 4,
   "module": "util:SetVariables",
   "version": 1,
   "metadata": {
    "designer": {
     "x": 900,
     "y": 0,
     "name": "4. Discount, reference and token"
    }
   },
   "mapper": {
    "scope": "roundtrip",
    "variables": [
     {
      "name": "discount",
      "value": "{{if(length(trim(ifempty(1.discount_override; \"\"))) > 0; parseNumber(1.discount_override); if(3.typeCount >= 2 and 3.minPrice < 9000000000; 3.minPrice / 2; 0))}}"
     },
     {
      "name": "discountLabel",
      "value": "{{if(length(trim(ifempty(1.discount_override; \"\"))) > 0; \"Discount (overridden)\"; \"Combined project discount\")}}"
     },
     {
      "name": "overridden",
      "value": "{{if(length(trim(ifempty(1.discount_override; \"\"))) > 0; \"yes\"; \"no\")}}"
     },
     {
      "name": "quoteRef",
      "value": "{{ifempty(1.quote_reference; \"BR-Q-\" + formatDate(now; \"YYYYMMDD\") + \"-\" + formatDate(now; \"HHmmss\"))}}"
     },
     {
      "name": "token",
      "value": "{{ifempty(1.approval_token; md5(formatDate(now; \"x\") + ifempty(1.customer_email; \"\") + \"BRQ-7f3a91d2\"))}}"
     },
     {
      "name": "stamp",
      "value": "{{formatDate(now; \"YYYY-MM-DD HH:mm:ss\"; \"Europe/London\")}}"
     },
     {
      "name": "isSubmit",
      "value": "{{if(lower(trim(ifempty(1.action; \"save\"))) = \"submit\"; \"yes\"; \"no\")}}"
     }
    ]
   }
  },
  {
   "id": 5,
   "module": "util:SetVariables",
   "version": 1,
   "metadata": {
    "designer": {
     "x": 1200,
     "y": 0,
     "name": "5. Total and status"
