        ],
        "cc": [],
        "bcc": [],
        "from": "\"BuildRegs\" <support@buildregs.co.uk>",
        "sender": "",
        "replyTo": "support@buildregs.co.uk",
        "subject": "Approve quotation {{4.quoteRef}} - {{1.property_address}}",
        "contentType": "html",
