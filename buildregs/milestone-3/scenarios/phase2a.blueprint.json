   "mapper": {
    "scope": "roundtrip",
    "variables": [
     {
      "name": "total",
      "value": "{{3.subtotal - 4.discount + parseNumber(ifempty(1.adjustment_amount; 0))}}"
     },
     {
      "name": "status",
      "value": "{{if(4.isSubmit = \"yes\"; \"Awaiting approval\"; \"Draft\")}}"
     }
    ]
   }
